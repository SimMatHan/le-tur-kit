{
  "name": "le-tur-2026",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "deploy": "npm run build && npm run verify:dist && npx --yes wrangler@4 pages deploy dist --project-name le-tur-2026 --branch main",
    "check:slides": "node scripts/check-slides.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "verify": "npm test && npm run build && npm run verify:dist && npm run check:slides && npm run test:e2e",
    "deploy:create": "npx --yes wrangler@4 pages project create le-tur-2026 --production-branch main"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  }
}
